# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Source code files
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf

# Web files
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.sass text eol=lf

# Data/Config files
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.env text eol=lf
*.env.* text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Lock files
bun.lock text eol=lf
package-lock.json text eol=lf
yarn.lock text eol=lf
pnpm-lock.yaml text eol=lf

# SQL
*.sql text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Git/Editor config
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
.prettierrc text eol=lf
.eslintrc text eol=lf

# Binary files (no line ending conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.mp3 binary
*.mp4 binary
*.webm binary

# Knowledge graph output (graphify) — generated, ~40MB across 22 files.
#
# `-merge` stops git attempting a line-by-line content merge on regenerated
# JSON. Every feature branch that refreshed the graph would otherwise conflict
# with every other one the moment any of them merged, producing megabytes of
# conflict markers in files nobody reads. With this set, git reports the
# conflict and the resolution is simply to regenerate.
#
# linguist-generated keeps the files collapsed in PR diffs, so a 40MB
# regeneration does not bury the reviewable change.
graphify-out/** -merge
graphify-out/** linguist-generated=true
