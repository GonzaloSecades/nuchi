# Local PostgreSQL connection string, read by the Go API. The frontend does not
# connect to Postgres.
# Docker Compose default: postgres://nuchi:nuchi@localhost:5432/nuchi?sslmode=disable
DATABASE_URL=postgres://nuchi:nuchi@localhost:5432/nuchi?sslmode=disable

# Public base URL used by the frontend API client.
# Local Next.js default: http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# Local SMTP settings. Docker Compose Mailpit defaults:
# SMTP: localhost:1025
# Web UI: http://localhost:8025
# The Go backend reads SMTP_ADDR (a single host:port), not SMTP_HOST/SMTP_PORT.
SMTP_ADDR=localhost:1025
MAILPIT_WEB_URL=http://localhost:8025

# From address on outgoing verification/reset mail.
MAIL_FROM=nuchi@localhost

# Origin used to build verification/reset links in emails. Must be
# origin-only: http or https, host, optional trailing "/", and no path,
# query, fragment, or userinfo. Validated at backend startup.
APP_BASE_URL=http://localhost:3000

# Lifetimes of the one-time email tokens, as Go durations.
AUTH_VERIFICATION_TOKEN_TTL=48h
AUTH_RESET_TOKEN_TTL=30m

# HMAC key the Go API signs and verifies access tokens with. Required, with no
# default: startup exits if it is unset or shorter than 32 bytes. Generate one
# with `openssl rand -base64 48`. Never commit a real value.
AUTH_JWT_SECRET=

# Secure attribute on the refresh cookie. false only works over plain HTTP,
# which is fine locally and never correct in a deployed environment.
AUTH_COOKIE_SECURE=false

# Local app/runtime flags.
# APP_ENV is informational for local tooling.
APP_ENV=local

# Go backend scaffold configuration.
# Defaults from backend/README.md: 0.0.0.0:8080
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080

# Where Next.js proxies /api/* to the Go backend. Server-side only:
# the browser never sees this and keeps calling the Next origin.
# Must be origin-only (no credentials, path, query, or fragment) — the matched
# request path is appended to it. Validated at build time.
GO_API_URL=http://localhost:8080
